{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "src/client",
    "outDir": "dist/client"
  },
  "include": [
    "src/client/**/*.ts"
  ]
}
